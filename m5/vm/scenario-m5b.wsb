<Configuration>
  <Networking>Disable</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>kit-m5b</HostFolder>
      <SandboxFolder>C:\kit</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>preuves-m5b</HostFolder>
      <SandboxFolder>C:\preuves</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell -NoProfile -ExecutionPolicy Bypass -File C:\kit\scenario-m5b.ps1</Command>
  </LogonCommand>
</Configuration>
