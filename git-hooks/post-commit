#!/usr/bin/env bash
# TRIADE — après chaque commit : synchro Google Drive (best effort, jamais bloquant).
# Installé dans .git/hooks/post-commit ; le modèle vit dans git-hooks/post-commit
# et scripts/sync_backup.sh le réinstalle automatiquement s'il manque.
# Sorties et erreurs journalisées dans .gdrive/last_sync.log (exclu du dépôt,
# D12) : un échec de synchro ne doit plus jamais être invisible — constat du
# 27/10/2026 : le miroir était à jour par chance, mais tout échec du hook
# aurait été silencieux (>/dev/null 2>&1).
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -f "$ROOT/.gdrive/oauth_token_relais.json" ] || exit 0
[ -f "$ROOT/scripts/drive_sync.py" ] || exit 0
LOG="$ROOT/.gdrive/last_sync.log"
{
  echo "--- $(date -u +%Y-%m-%dT%H:%M:%SZ) commit $(git rev-parse --short HEAD 2>/dev/null)"
  python3 "$ROOT/scripts/drive_sync.py" --quiet
  echo "--- fin (rc=$?)"
} >>"$LOG" 2>&1 || true
exit 0
