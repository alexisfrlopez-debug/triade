# Secrets — JAMAIS committer ni synchroniser
.gdrive/
*.token
token_*.txt
client_secret*.json
*_sa.json
service_account*.json
credentials*.json
git-credentials

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Système
.DS_Store
Thumbs.db
desktop.ini

# Journaux et temporaires
*.log
tmp/

# Secrets de la carte (D12/D27) — centralisés au racine, jamais committes
/.keys/
m0/.keys/
m1/.keys/

# Coffre-fort des phrases maitresses (D75) — conteneur chiffre, jamais commite
/.keys/coffre_fort.bin
coffre_fort*.bin
coffre_session.tmp

# Export de continuité (D16) — conteneur de coffre, jamais commite
m1/export/

# Témoins temporaires de l'oracle natif m6 (régénérés à chaque run)
m6/.tmp/

# Témoins temporaires de l'oracle natif du jalon M6 (unix/, D149 — même
# convention que m6/.tmp/ : régénérés à chaque run, jamais committés)
unix/.tmp/

# Instruments du jalon M7 (riscv/, D149) : qemu-user extrait localement
# (SANS sudo — installer_qemu.sh, la PROCÉDURE est la pièce du dépôt, le
# binaire est l'instrument) + témoins de l'oracle qemu (régénérés)
riscv/.tmp/

# Variante livraison du superviseur (annexe jetons intégrée, D49) — jamais committée
terrain/livraison/

# Bundles de passation locaux (D141 : le bundle vivant = la canonique au
# miroir Drive ; la copie labo est une zone de travail, JAMAIS committée
# — Entrée 132 : la convention devient mécanique, git add -A ne peut plus
# l'avaler)
bundles-*/

# Zone de travail locale du labo (miroirs de pièces, index de clôture) —
# JAMAIS committée (modèle bundles-*/, Entrée 132 ; les pièces durables
# vivent au coffre Drive, jamais au dépôt)
upload/
riscv/export/

# Les outils TLA+/Apalache : ENVIRONNEMENT, pas artefacts (re-téléchargeables,
# empreintes recoupées par le vérifieur de clone frais)
scripts/tla_v150/outils/
scripts/tla_v150/_apalache-out/
scripts/tla_v150/pbt_zone/
